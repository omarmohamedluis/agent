{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: OMI client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client/client.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/sudo_python.sh",
            "justMyCode": false
        },
        {
            "name": "Python: OMI midi",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client/servicios/MIDI/service.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/sudo_python.sh",
            "justMyCode": false,
        },
        {
            "name": "Python: Archivo actual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "Python: OMI server",
            "type": "debugpy",
            "request": "launch",
            "module": "server.omi_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        }
    ],
    "compounds": [
        {
            "name": "Python: Server + Client",
            "configurations": [
                "Python: OMI server",
                "Python: OMI client"
            ],
            "stopAll": true
        },
        {
            "name": "Python: Server + Client (delay)",
            "configurations": [
                "Python: OMI server",
                "Python: OMI client"
            ],
            "stopAll": true
        }
    ]
}