{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OMI: servidor simulado",
      "type": "debugpy",
      "request": "launch",
      "module": "omi",
      "args": ["server", "--simulate", "--data-dir", ".omi-dev/server", "--host", "127.0.0.1", "--no-beacon"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"}
    },
    {
      "name": "OMI: Pi simulada",
      "type": "debugpy",
      "request": "launch",
      "module": "omi",
      "args": ["client", "--simulate", "--serial", "dev-pi-1", "--data-dir", ".omi-dev/client", "--host", "127.0.0.1", "--server", "http://127.0.0.1:8080"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"}
    },
    {
      "name": "OMI: pruebas",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"}
    }
  ],
  "compounds": [{"name": "OMI: servidor + Pi simulados", "configurations": ["OMI: servidor simulado", "OMI: Pi simulada"], "stopAll": true}]
}
