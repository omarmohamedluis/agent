{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: OMI client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client/client.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/sudo_python.sh",
            "justMyCode": false
        },
        {
            "name": "Python: OMI server",
            "type": "debugpy",
            "request": "launch",
            "module": "server.app",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "name": "Python: OMI client (delayed)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client/client.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/sudo_python.sh",
            "justMyCode": false,
            "preLaunchTask": "wait-for-server"
        },
        {
            "name": "Windows Server",
            "type": "debugpy",
            "request": "launch",
            "module": "server.app",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "windows": {
                "python": "python.exe"
            },
            "justMyCode": false
        },
    ],
    "compounds": [
        {
            "name": "Python: Server + Client (delay)",
            "configurations": [
                "Python: OMI server",
                "Python: OMI client (delayed)"
            ],
            "stopAll": true
        }
    ]
}