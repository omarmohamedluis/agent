#!/usr/bin/env bash
# Privileged entry point. Only root-owned installed files may choose commands.
set -Eeuo pipefail
role=${1:-}; shift || true
case "$role" in client|server) ;; *) echo 'Invalid OMI role' >&2; exit 2;; esac
[[ $(id -u) == 0 ]] || { echo 'omi-update requires sudo' >&2; exit 1; }
[[ $(cat /etc/omi/role) == "$role" ]] || { echo 'OMI role mismatch' >&2; exit 2; }
ref=v3
operation_id=
while (($#)); do
    case "$1" in
        --ref) ref=${2:?}; shift 2;;
        --operation-id) operation_id=${2:?}; shift 2;;
        *) echo 'Unsupported OMI update argument' >&2; exit 2;;
    esac
done
[[ "$ref" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ && "$ref" != *..* ]] || exit 2
[[ "$operation_id" =~ ^[A-Za-z0-9-]{1,80}$ ]] || { echo 'An operation ID is required' >&2; exit 2; }
exec systemd-run --unit="omi-update-$operation_id" --collect --no-block --property=Type=exec \
    /bin/bash /opt/omi/current/scripts/update.sh "$role" --ref "$ref" --operation-id "$operation_id"
