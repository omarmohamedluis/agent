{
    "MIDI": {
        "info": {
            "id": "MIDI",
            "display_name": "OMI MIDI",
            "service_type": "process",
            "description": "Traduce eventos MIDI a OSC y gestiona la Web UI."
        },
        "web": {
            "USE": true,
            "ui_port": 9001
        },
        "network": {
            "vlan": null,
            "vlan_active": false
        },
        "execution": {
            "cwd": "servicios/MIDI",
            "entry": [
                "${PYTHON}",
                "service.py"
            ],
            "restart_policy": "always",
            "graceful_timeout_s": 20
        },
        "logs": {
            "stdout": "logs/services/midi.log",
            "stderr": "logs/services/midi.log",
            "max_size_mb": 10
        }
    },
    "satellite": {
        "info": {
            "id": "satellite",
            "display_name": "Companion Satellite",
            "service_type": "process",
            "description": "Servicio de integración Companion Satellite."
        },
        "web": {
            "USE": false
        },
        "network": {
            "vlan": null,
            "vlan_active": false
        },
        "execution": {
            "cwd": "servicios/satellite",
            "entry": [
                "${PYTHON}",
                "service.py"
            ],
            "restart_policy": "always",
            "graceful_timeout_s": 20
        },
        "logs": {
            "stdout": "logs/services/satellitelog.out",
            "stderr": "logs/services/satellitelog.err",
            "max_size_mb": 10
        }
    },
    "OSCnum": {
        "info": {
            "id": "OSCnum",
            "display_name": "OSCnum Key",
            "service_type": "process",
            "description": "Gateway OSC."
        },
        "web": {
            "USE": false
        },
        "network": {
            "vlan": null,
            "vlan_active": false
        },
        "execution": {
            "cwd": "servicios/OSCnum",
            "entry": [
                "${PYTHON}",
                "service.py"
            ],
            "restart_policy": "always",
            "graceful_timeout_s": 20
        },
        "logs": {
            "stdout": "logs/services/osclog.out",
            "stderr": "logs/services/osclog.err",
            "max_size_mb": 10
        }
    }
}