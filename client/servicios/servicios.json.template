{
  "services": [
    {
      "id": "MIDI",
      "display_name": "OMI MIDI",
      "type": "process",
      "cwd": "servicios/MIDI",
      "entry": [
        "${PYTHON}",
        "service.py"
      ],
      "logs": {
        "stdout": "logs/services/midi.log",
        "stderr": "logs/services/midi.log"
      },
      "web_port": 9001,
      "description": "Traduce eventos MIDI a OSC y gestiona la Web UI."
    },
    {
      "id": "satellite",
      "display_name": "Companion Satellite",
      "type": "process",
      "cwd": "servicios/satellite",
      "entry": [
        "${PYTHON}",
        "service.py"
      ],
      "logs": {
        "stdout": "logs/services/satellitelog.log",
        "stderr": "logs/services/satellitelog.err"
      },
      "web_port": 9002,
      "description": "Servicio de integración Companion Satellite."
    },
    {
      "id": "OSCnum",
      "display_name": "OSCnum Key",
      "type": "process",
      "cwd": "servicios/OSCnum",
      "entry": [
        "${PYTHON}",
        "service.py"
      ],
      "logs": {
        "stdout": "logs/services/osclog.out",
        "stderr": "logs/services/osclog.err"
      },
      "description": "Gateway OSC."
    }
  ]
}