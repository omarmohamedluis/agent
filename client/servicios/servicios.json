      "cwd": "servicios/MIDI",
      "entry": [
        "${PYTHON}",
        "service.py"
      ],
      "logs": {
        "stdout": "logs/services/midi.log",
        "stderr": "logs/services/midi.log"
      },
      "web_port": 9001,
      "description": "Traduce eventos MIDI a OSC y gestiona la Web UI."
    },
    {
      "id": "satellite",
      "display_name": "Companion Satellite",
      "type": "process",
      "cwd": "servicios/satellite",
